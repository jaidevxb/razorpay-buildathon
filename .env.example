# Copy this file to .env and fill in your own keys. Never commit .env.

# Razorpay TEST MODE keys (dashboard.razorpay.com -> Settings -> API Keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_secret_here

# Google Gemini API key
GEMINI_API_KEY=your_gemini_key_here

# Webhook signing secret (Settings -> Webhooks) — only needed if you point
# a Razorpay webhook at POST /webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here
